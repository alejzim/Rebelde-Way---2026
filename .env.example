# Copiá este archivo como .env. Configurá las mismas 4 variables en Vercel.
# URL y clave publicable: Supabase > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SOLO SERVIDOR. Supabase > Project Settings > API Keys > Secret keys.
# Nunca agregues el prefijo VITE_ a esta clave ni a la contraseña.
SUPABASE_SECRET_KEY=

# Usá una contraseña única y segura de al menos 12 caracteres.
# Cambiarla invalida las sesiones administrativas existentes.
ADMIN_PASSWORD=
